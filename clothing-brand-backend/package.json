{
  "name": "clothing-brand-backend",
  "version": "1.0.0",
  "description": "Backend API for MERN clothing brand",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "data:import": "node seeder.js",
    "data:destroy": "node seeder.js -d",
    "merchant:setup": "node merchant_sync.js setup",
    "merchant:sync": "node merchant_sync.js sync",
    "merchant:status": "node merchant_sync.js status"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ip-address": "^9.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.5.0",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^10.0.13",
    "razorpay": "^2.9.8"
  }
}
